NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# Get a free key at https://console.groq.com — powers the agentic
# pipeline's LLM (models/agentic/generator.py). If unset, the pipeline
# falls back to a local Ollama server (llama3.1:8b) instead.
GROQ_API_KEY=your_groq_api_key_here
# Optional: force a backend regardless of GROQ_API_KEY ("groq" or "ollama").
# LLM_BACKEND=ollama
